# -- StormSight Backend -- Environment Variables
# Copy to .env and fill in values before running docker compose

# -- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=stormsight
POSTGRES_PASSWORD=stormsight_secret
POSTGRES_DB=stormsight

# -- Database URLs (auto-set by docker-compose, override if needed)
DATABASE_URL=postgresql+asyncpg://stormsight:stormsight_secret@db:5432/stormsight
DATABASE_SYNC_URL=postgresql+psycopg2://stormsight:stormsight_secret@db:5432/stormsight

# -- Application --------------------------------------------------------------
DEBUG=true
API_VERSION=v1

# -- CORS ----------------------------------------------------------------------
CORS_ORIGINS=*

# -- Data paths (inside container) ---------------------------------------------
DATA_ROOT=/data
RADAR_DATA_DIR=/data/raw/radar
LIGHTNING_DATA_DIR=/data/raw/lightning
SATELLITE_DATA_DIR=/data/raw/satellite
NWP_DATA_DIR=/data/raw/nwp

# -- ML ------------------------------------------------------------------------
ML_PACKAGE_PATH=/ml
ML_FORCE_STUB=false

# -- Redis ---------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -- Kafka / Redpanda ----------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_RADAR_TOPIC=radar.scans
KAFKA_LIGHTNING_TOPIC=lightning.strokes

# -- Nowcasting ----------------------------------------------------------------
NOWCAST_HORIZON_MINUTES=120
NOWCAST_INTERVAL_MINUTES=15
ALERT_THRESHOLD_PROBABILITY=0.60
